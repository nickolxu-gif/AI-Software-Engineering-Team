{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"agent-status.schema.json","type":"object","required":["schema_version","dispatch_id","agent_id","role","state","updated_at"],"properties":{"schema_version":{"const":1},"dispatch_id":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$"},"agent_id":{"type":"string","minLength":1,"maxLength":128},"role":{"type":"string","minLength":1,"maxLength":128},"model":{"type":["string","null"],"minLength":1,"maxLength":128},"state":{"enum":["IN_PROGRESS","COMPLETED","BLOCKED","NEEDS_DIRECTION"]},"progress":{"type":"integer","minimum":0,"maximum":100},"current_subtask":{"type":["string","null"],"minLength":1,"maxLength":256},"completed":{"type":"array","maxItems":20,"items":{"type":"string","minLength":1,"maxLength":256}},"findings":{"type":"array","maxItems":20,"items":{"type":"string","minLength":1,"maxLength":256}},"risks":{"type":"array","maxItems":20,"items":{"type":"string","minLength":1,"maxLength":256}},"recommendation":{"type":["string","null"],"minLength":1,"maxLength":512},"updated_at":{"type":"string","format":"date-time"}},"additionalProperties":false}
