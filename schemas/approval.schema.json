{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"approval.schema.json","type":"object","required":["schema_version","approval_id","dispatch_id","action","target_sha","request_hash","expires_at","consumed_at","status","idempotency_key"],"properties":{"schema_version":{"const":1},"approval_id":{"type":"string"},"dispatch_id":{"type":"string"},"action":{"type":"string"},"target_sha":{"type":"string","pattern":"^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},"request_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"nonce_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"expires_at":{"type":"string","format":"date-time"},"consumed_at":{"type":["string","null"],"format":"date-time"},"status":{"enum":["PENDING","CONSUMED"]},"idempotency_key":{"type":"string","minLength":1}},"allOf":[{"if":{"properties":{"status":{"const":"PENDING"}}},"then":{"properties":{"consumed_at":{"type":"null"}}}},{"if":{"properties":{"status":{"const":"CONSUMED"}}},"then":{"properties":{"consumed_at":{"type":"string","format":"date-time"}}}}],"additionalProperties":true}
