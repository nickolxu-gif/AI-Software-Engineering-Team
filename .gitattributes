# Normalize all detected text files to LF in the repository and worktree.
* text=auto eol=lf

# Common text formats
*.md text eol=lf
*.markdown text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf

# Common image formats
*.avif binary
*.bmp binary
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.png binary
*.tif binary
*.tiff binary
*.webp binary

# PDF and Office documents
*.pdf binary
*.doc binary
*.docx binary
*.ppt binary
*.pptx binary
*.xls binary
*.xlsx binary

# Archives and compressed packages
*.7z binary
*.bz2 binary
*.gz binary
*.rar binary
*.tar binary
*.tgz binary
*.xz binary
*.zip binary
